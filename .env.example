# Clerk (https://dashboard.clerk.com). Only NEXT_PUBLIC_* values reach the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity. The project id and dataset are not secrets; the read token is server only.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-31
SANITY_API_READ_TOKEN=
# Server only. Editor-role token used solely by POST /api/progress to save learner progress.
SANITY_API_WRITE_TOKEN=

# Neon Postgres (server only), pulled by `neon deploy` / `neon env pull`. The app uses the
# pooled DATABASE_URL; migrations use DATABASE_URL_UNPOOLED (direct connection).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Admin console (server only). The owner's Clerk user id(s), comma separated: always an
# admin, the only one who can add or remove admins, and never editable from the UI.
ROAM_OWNER_USER_IDS=
# "true" blocks admins without two-factor auth from the console. Turn on once your 2FA is set up.
ADMIN_REQUIRE_MFA=false

# Where the admin menu's "Sanity Studio" link points (not a secret).
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
